{
    "name": "gpio/i2c",
    "description": "The GeneralPurposeIO I2C package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/scrapyard-io/framework/issues",
        "source": "https://github.com/scrapyard-io/framework"
    },
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/common": "^0.8.0",
        "gpio/contracts": "^0.8.0",
        "gpio/digital": "^0.8.0",
        "venusian-voyager/console": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0",
        "venusian-voyager/magic-aliases": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "suggest": {
        "microscrap/i2c": "^0.8.0 - POSIX I2C",
        "microscrap/gpio": "^0.8.0 - POSIX Digital Pins",
        "microscrap/mpsse": "^0.8.0 - MPSSE USB Drivers"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "GeneralPurposeIO\\I2C\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "GeneralPurposeIO\\I2C\\I2CServiceProvider"
            ]
        }
    }
}
