{
    "name": "gpio/digital",
    "description": "GeneralPurposeIO digital IO: the gpio.digital connection manager, driver, factory and pin transports.",
    "type": "library",
    "keywords": [
        "scrapyard-io",
        "gpio",
        "digital-io"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.8.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.8.x/overview",
        "source": "https://github.com/scrapyard-io/framework",
        "issues": "https://github.com/scrapyard-io/framework/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.8.0",
        "venusian-voyager/collections": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0",
        "venusian-voyager/magic-aliases": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "suggest": {
        "microscrap/scrapyard-linux": "^0.8.0 - native libgpiod pins",
        "microscrap/scrapyard-usb": "^0.8.0 - MPSSE pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "GeneralPurposeIO\\Digital\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "GeneralPurposeIO\\Digital\\DigitalIOServiceProvider"
            ],
            "aliases": {
                "DigitalIO": "GeneralPurposeIO\\Digital\\DigitalIO"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
