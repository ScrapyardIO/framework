{
    "name": "gpio/contracts",
    "description": "GeneralPurposeIO contracts: transports, offloaded transports, protocol enums, exceptions, BusJob, the chip vocabulary and the loop mail.",
    "type": "library",
    "keywords": [
        "scrapyard-io",
        "gpio",
        "contracts"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.8.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.8.x/overview",
        "source": "https://github.com/scrapyard-io/framework",
        "issues": "https://github.com/scrapyard-io/framework/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian-voyager/contracts": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "GeneralPurposeIO\\Contracts\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
