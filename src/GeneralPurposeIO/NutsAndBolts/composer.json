{
    "name": "gpio/nuts-and-bolts",
    "description": "GeneralPurposeIO byte helpers: array2bytes, bytes2array, byte2bits, bits2byte.",
    "type": "library",
    "keywords": [
        "scrapyard-io",
        "gpio",
        "bytes"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.9.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.9.x/overview",
        "source": "https://github.com/scrapyard-io/framework",
        "issues": "https://github.com/scrapyard-io/framework/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.9.0",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/io-pools": "^0.9.0"
    },
    "autoload": {
        "psr-4": {
            "GeneralPurposeIO\\NutsAndBolts\\": ""
        },
        "files": [
            "Helpers/bytes.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
