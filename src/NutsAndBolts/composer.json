        },
        "files": [
            "Helpers/support.php",
            "Helpers/bytes.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.5.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
