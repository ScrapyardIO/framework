{
    "name": "fabricate/framebuffers",
    "description": "The Fabricate Framebuffers package.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "fabricate/contracts": "^0.5.0",
        "fabricate/nuts-and-bolts": "^0.5.0",
        "psr/container": "^1.1.1 || ^2.0.1"
    },
    "provide": {
        "psr/container-implementation": "1.1 || 2.0"
    },
    "minimum-stability": "dev",
    "autoload": {
