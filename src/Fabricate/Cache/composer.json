{
    "name": "fabricate/cache",
    "description": "The Fabricate Cache package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/ScrapyardIO/framework/issues",
        "source": "https://github.com/ScrapyardIO/framework"
    },
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/collections": "^0.7.0",
        "fabricate/contracts": "^0.7.0",
        "fabricate/events": "^0.7.0",
        "fabricate/filesystem": "^0.7.0",
        "fabricate/macroable": "^0.7.0",
        "fabricate/nuts-and-bolts": "^0.7.0"
    },
    "suggest": {
        "fabricate/redis": "Required to use the redis cache store (^0.7.0).",
        "ext-redis": "Required when fabricate/redis uses the phpredis connector (^4.0 || ^5.0 || ^6.0).",
        "predis/predis": "Required when fabricate/redis uses the predis connector (^2.3 || ^3.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Fabricate\\Cache\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        }
    }
}
