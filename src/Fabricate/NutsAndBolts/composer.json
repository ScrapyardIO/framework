{
    "name": "fabricate/nuts-and-bolts",
    "description": "The Fabricate Support package.",
    "license": "MIT",
    "require": {
        "ext-intl": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ramsey/uuid": "^4.7",
        "php": "^8.4|^8.5|^8.6",
        "nesbot/carbon": "^3.8.4",
        "league/commonmark": "^2.8.1",
        "doctrine/inflector": "^2.0.5",
        "fabricate/contracts": "^0.5.0",
        "fabricate/macroable": "^0.5.0",
        "voku/portable-ascii": "^2.0.2",
        "fabricate/reflection": "^0.5.0",
        "fabricate/collections": "^0.5.0",
        "symfony/uid": "^7.4.0 || ^8.0.0",
        "fabricate/conditionable": "^0.5.0",
        "symfony/var-dumper": "^7.4.0 || ^8.0.0"
    },
    "suggest": {
        "symfony/var-dumper": "Required to use the dump method (^7.4 || ^8.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Fabricate\\NutsAndBolts\\": ""
        },
        "files": [
            "functions.php",
            "helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.5.x-dev"
        }
    }
}
