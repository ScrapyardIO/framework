{
    "name": "fabricate/nuts-and-bolts",
    "description": "The Fabricate Support package.",
    "license": "MIT",
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ramsey/uuid": "^4.7",
        "nesbot/carbon": "^3.8.4",
        "vlucas/phpdotenv": "^5.6.1",
        "league/commonmark": "^2.8.1",
        "voku/portable-ascii": "^2.0.2",
        "fabricate/macroable": "^0.6.0",
        "fabricate/collections": "^0.6.0",
        "symfony/uid": "^7.4.0 || ^8.0.0",
        "symfony/var-dumper": "^7.4.0 || ^8.0.0"
    },
    "suggest": {},
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Fabricate\\NutsAndBolts\\": ""
        },
        "files": [
            "Helpers/functions.php",
            "Helpers/helpers.php",
            "Helpers/bytes.php",
            "Helpers/time.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.5.x-dev"
        }
    }
}
