{
    "name": "fabricate/collections",
    "description": "The Fabricate Collections package.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "fabricate/conditionable": "^0.5.0",
        "fabricate/contracts": "^0.5.0",
        "fabricate/macroable": "^0.5.0"
    },
    "suggest": {
        "symfony/var-dumper": "Required to use the dump method (^7.4 || ^8.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Fabricate\\NutsAndBolts\\": ""
        },
        "files": [
            "functions.php",
            "helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.5.x-dev"
        }
    }
}
