{
    "name": "scrapyard-io/framework",
    "description": "The ScrapyardIO Framework.",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "version": "0.5.1",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/scrapyard-io/framework/issues",
        "source": "https://github.com/scrapyard-io/framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ramsey/uuid": "^4.7",
        "nesbot/carbon": "^3.8.4",
        "vlucas/phpdotenv": "^5.6.1",
        "league/commonmark": "^2.8.1",
        "voku/portable-ascii": "^2.0.2",
        "symfony/polyfill-php84": "^1.36",
        "symfony/polyfill-php85": "^1.36",
        "symfony/polyfill-php86": "^1.36",
        "symfony/uid": "^7.4.0 || ^8.0.0",
        "psr/container": "^1.1.1 || ^2.0.1",
        "symfony/finder": "^7.4.0 || ^8.0.0",
        "symfony/mime": "^7.4.0 || ^8.0.0",
        "symfony/process": "^7.4.5 || ^8.0.5",
        "symfony/console": "^7.4.0 || ^8.0.0",
        "symfony/event-dispatcher": "^7.4.0 || ^8.0.0",
        "symfony/filesystem": "^7.4.0 || ^8.0.0",
        "symfony/var-dumper": "^7.4.0 || ^8.0.0",
        "laravel/prompts": "^0.3.0",
        "nunomaduro/termwind": "^2.0"
    },
    "suggest": {
        "ext-posi": "^0.5.0",
        "ext-ftdi": "^0.5.0",
        "microscrap/posix": "^0.5.1",
        "microscrap/ftdi": "^0.5.1",
        "microscrap/mpsse": "^0.5.1"
    },
    "replace": {
        "bare-metal/actuation": "self.version",
        "bare-metal/circuits": "self.version",
        "bare-metal/chassis": "self.version",
        "bare-metal/contracts": "self.version",
        "bare-metal/collections": "self.version",
        "bare-metal/filesystem": "self.version",
        "bare-metal/displays": "self.version",
        "bare-metal/framebuffers": "self.version",
        "bare-metal/gfx": "self.version",
        "bare-metal/sensors": "self.version",

        "waveforms/common": "self.version",
        "waveforms/contracts": "self.version",
        "waveforms/digital": "self.version",
        "waveforms/i2c": "self.version",
        "waveforms/spi": "self.version",
        "waveforms/pwm": "self.version",
        "waveforms/uart": "self.version",

        "scrapyard-io/nuts-and-bolts": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "files": [
            "src/NutsAndBolts/Helpers/bytes.php",
            "src/NutsAndBolts/Helpers/support.php",
            "src/NutsAndBolts/Helpers/functions.php",
            "src/BareMetal/Core/Helpers/helpers.php",
            "src/BareMetal/Filesystem/functions.php",
            "src/BareMetal/Collections/Helpers/helpers.php",
            "src/BareMetal/Collections/Helpers/functions.php"
        ],
        "psr-4": {
            "GPIO\\": "src/GPIO/",
            "BareMetal\\": "src/BareMetal/",
            "ScrapyardIO\\NutsAndBolts\\": [
                "src/NutsAndBolts/",
                "src/BareMetal/Collections/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.5.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
