{
    "name": "scrapyard-io/framework",
    "description": "The ScrapyardIO Framework.",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "version": "0.5.1",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/scrapyard-io/framework/issues",
        "source": "https://github.com/scrapyard-io/framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "ext-intl": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ramsey/uuid": "^4.7",
        "php": "^8.4|^8.5|^8.6",
        "nesbot/carbon": "^3.8.4",
        "monolog/monolog": "^3.0",
        "laravel/prompts": "^0.3.0",
        "vlucas/phpdotenv": "^5.6.1",
        "league/commonmark": "^2.8.1",
        "nunomaduro/termwind": "^2.0",
        "predis/predis": "^2.3|^3.0",
        "doctrine/inflector": "^2.0.5",
        "voku/portable-ascii": "^2.0.2",
        "league/flysystem-ftp": "^3.25.1",
        "symfony/uid": "^7.4.0 || ^8.0.0",
        "symfony/mime": "^7.4.0 || ^8.0.0",
        "psr/container": "^1.1.1 || ^2.0.1",
        "symfony/finder": "^7.4.0 || ^8.0.0",
        "league/flysystem-sftp-v3": "^3.25.1",
        "symfony/console": "^7.4.0 || ^8.0.0",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "league/flysystem-read-only": "^3.25.1",
        "symfony/filesystem": "^7.4.0 || ^8.0.0",
        "symfony/var-dumper": "^7.4.0 || ^8.0.0",
        "symfony/error-handler": "^7.4.0 || ^8.0.0",
        "league/flysystem-path-prefixing": "^3.25.1",
        "symfony/event-dispatcher": "^7.4.0 || ^8.0.0"
    },
    "suggest": {
        "ext-redis": "Required to use the phpredis connector (^4.0 || ^5.0 || ^6.0)."
    },
    "replace": {
        "fabricate/gfx": "self.version",
        "fabricate/chassis": "self.version",
        "fabricate/displays": "self.version",
        "fabricate/framebuffers": "self.version",
        "fabricate/macroable": "self.version",
        "fabricate/contracts": "self.version",
        "fabricate/filesystem": "self.version",
        "fabricate/reflections": "self.version",
        "fabricate/collections": "self.version",
        "fabricate/conditionable": "self.version",
        "fabricate/nuts-and-bolts": "self.version",

        "gpio/common": "self.version",
        "gpio/contracts": "self.version",
        "gpio/digital": "self.version",
        "gpio/i2c": "self.version",
        "gpio/spi": "self.version",
        "gpio/pwm": "self.version",
        "gpio/uart": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "files": [
            "src/Fabricate/Core/helpers.php",
            "src/Fabricate/Collections/helpers.php",
            "src/Fabricate/Collections/functions.php",
            "src/Fabricate/Filesystem/functions.php",
            "src/Fabricate/NutsAndBolts/helpers.php",
            "src/Fabricate/NutsAndBolts/functions.php",
            "src/Fabricate/Log/functions.php"
        ],
        "psr-4": {
            "Fabricate\\": "src/Fabricate/",
            "GeneralPurposeIO\\": "src/GeneralPurposeIO/",
            "Fabricate\\NutsAndBolts\\": [
                "src/Fabricate/Macroable/",
                "src/Fabricate/Collections/",
                "src/Fabricate/Conditionable/",
                "src/Fabricate/Reflection/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.5.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
