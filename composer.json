{
    "name": "scrapyard-io/framework",
    "description": "The ScrapyardIO Framework.",
    "keywords": [
        "framework",
        "scrapyard-io"
    ],
    "license": "MIT",
    "version": "0.7.0",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/scrapyard-io/framework/issues",
        "source": "https://github.com/scrapyard-io/framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17 || ^0.18",
        "dragonmantank/cron-expression": "^3.4",
        "egulias/email-validator": "^4.0",
        "guzzlehttp/guzzle": "^7.8.2",
        "guzzlehttp/uri-template": "^1.0",
        "laravel/prompts": "^0.3.22",
        "laravel/serializable-closure": "^2.0.10",
        "league/commonmark": "^2.8.1",
        "monolog/monolog": "^3.0",
        "nesbot/carbon": "^3.8.4",
        "nunomaduro/termwind": "^2.0",
        "psr/container": "^1.1.1 || ^2.0.1",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "ramsey/uuid": "^4.7",
        "symfony/console": "^7.4.0 || ^8.0.0",
        "symfony/error-handler": "^7.4.0 || ^8.0.0",
        "symfony/event-dispatcher": "^7.4.0 || ^8.0.0",
        "symfony/filesystem": "^7.4.0 || ^8.0.0",
        "symfony/finder": "^7.4.0 || ^8.0.0",
        "symfony/http-foundation": "^7.4.0 || ^8.0.0",
        "symfony/mime": "^7.4.0 || ^8.0.0",
        "symfony/polyfill-php86": "^1.41",
        "symfony/process": "^7.4.5 || ^8.0.5",
        "symfony/uid": "^7.4.0 || ^8.0.0",
        "symfony/var-dumper": "^7.4.0 || ^8.0.0",
        "vlucas/phpdotenv": "^5.6.1",
        "voku/portable-ascii": "^2.0.2"
    },
    "suggest": {
        "ext-pdo_sqlite": "Required to use the SQLite database driver.",
        "ext-pdo_mysql": "Required to use the MySQL / MariaDB database driver.",
        "ext-pdo_pgsql": "Required to use the PostgreSQL database driver.",
        "ext-redis": "Required to use the phpredis Redis connector (^4.0 || ^5.0 || ^6.0).",
        "predis/predis": "Required to use the predis Redis connector (^2.3 || ^3.0).",
        "league/flysystem": "Required to use the Flysystem local driver (^3.25.1).",
        "league/flysystem-ftp": "Required to use the Flysystem FTP driver (^3.25.1).",
        "league/flysystem-sftp-v3": "Required to use the Flysystem SFTP driver (^3.25.1).",
        "league/flysystem-path-prefixing": "Required to use scoped disks (^3.25.1).",
        "league/flysystem-read-only": "Required to use read-only disks (^3.25.1).",
        "nunomaduro/pokio": "Required to use the pokio concurrency driver (^0.1).",
        "spatie/fork": "Required to use the fork concurrency driver (^1.2).",
        "laudis/neo4j-php-client": "Required to use fabricate/graph Neo4j connections (^3.3)."
    },
    "replace": {
        "fabricate/bus": "self.version",
        "fabricate/cache": "self.version",
        "fabricate/chassis": "self.version",
        "fabricate/collections": "self.version",
        "fabricate/concurrency": "self.version",
        "fabricate/conditionable": "self.version",
        "fabricate/config": "self.version",
        "fabricate/console": "self.version",
        "fabricate/contracts": "self.version",
        "fabricate/database": "self.version",
        "fabricate/encryption": "self.version",
        "fabricate/events": "self.version",
        "fabricate/filesystem": "self.version",
        "fabricate/graph": "self.version",
        "fabricate/hashing": "self.version",
        "fabricate/http": "self.version",
        "fabricate/json-schema": "self.version",
        "fabricate/log": "self.version",
        "fabricate/macroable": "self.version",
        "fabricate/magic-aliases": "self.version",
        "fabricate/nuts-and-bolts": "self.version",
        "fabricate/pagination": "self.version",
        "fabricate/pipeline": "self.version",
        "fabricate/process": "self.version",
        "fabricate/queue": "self.version",
        "fabricate/redis": "self.version",
        "fabricate/reflection": "self.version",
        "fabricate/sketches": "self.version",
        "fabricate/translation": "self.version",
        "fabricate/validation": "self.version"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^2.0",
        "laudis/neo4j-php-client": "^3.3.0",
        "league/flysystem": "^3.25.1",
        "league/flysystem-path-prefixing": "^3.25.1",
        "league/flysystem-read-only": "^3.25.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4",
        "predis/predis": "^2.3"
    },
    "autoload": {
        "files": [
            "src/Fabricate/Core/Helpers/helpers.php",
            "src/Fabricate/NutsAndBolts/Helpers/functions.php",
            "src/Fabricate/NutsAndBolts/Helpers/helpers.php",
            "src/Fabricate/NutsAndBolts/Helpers/bytes.php",
            "src/Fabricate/NutsAndBolts/Helpers/time.php",
            "src/Fabricate/Collections/Helpers/helpers.php",
            "src/Fabricate/Collections/Helpers/functions.php",
            "src/Fabricate/Filesystem/Helpers/functions.php",
            "src/Fabricate/Console/Prompts/helpers.php",
            "src/Fabricate/Concurrency/Fiber/functions.php",
            "src/Fabricate/Graph/Helpers/functions.php"
        ],
        "psr-4": {
            "Fabricate\\": "src/Fabricate/",
            "Fabricate\\NutsAndBolts\\": [
                "src/Fabricate/Macroable/",
                "src/Fabricate/Collections/",
                "src/Fabricate/Conditionable/",
                "src/Fabricate/Reflection/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.6-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
