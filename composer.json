{
  "name": "scrapyard-io/framework",
  "description": "The ScrapyardIO GPIO Framework.",
  "keywords": ["framework", "scrapyard-io", "gpio", "venusian"],
  "license": "MIT",
  "version": "0.8.0",
  "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.8.x/overview",
  "support": {
    "issues": "https://github.com/scrapyard-io/framework/issues",
    "source": "https://github.com/scrapyard-io/framework",
    "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/scrapyard-io/framework/0.8.x/overview"
  },
  "authors": [{ "name": "Angel Gonzalez", "email": "angel@projectsaturnstudios.com" }],
  "require": {
    "php": "^8.4|^8.5|^8.6",
    "venusian/framework": "^0.8.0"
  },
  "replace": {
    "gpio/analog": "self.version",
    "gpio/circuits": "self.version",
    "gpio/common": "self.version",
    "gpio/contracts": "self.version",
    "gpio/digital": "self.version",
    "gpio/i2c": "self.version",
    "gpio/spi": "self.version",
    "gpio/pwm": "self.version",
    "gpio/uart": "self.version"
  },
  "require-dev": {
    "microscrap/ftdi": "^0.8.0",
    "microscrap/gpio": "^0.8.0",
    "microscrap/i2c": "^0.8.0",
    "microscrap/mpsse": "^0.8.0",
    "microscrap/posix": "^0.8.0",
    "microscrap/spi": "^0.8.0",
    "microscrap/uart": "^0.8.0",
    "pestphp/pest": "^4"
  },
  "suggest": {
    "microscrap/gpio": "^0.8.0 - POSIX digital IO (libgpiod v2 over ext-posi)",
    "microscrap/i2c": "^0.8.0 - POSIX I2C",
    "microscrap/spi": "^0.8.0 - POSIX SPI",
    "microscrap/uart": "^0.8.0 - POSIX UART",
    "microscrap/ftdi": "^0.8.0 - FTDI USB drivers",
    "microscrap/mpsse": "^0.8.0 - MPSSE USB drivers"
  },
  "autoload": {
    "psr-4": { "GeneralPurposeIO\\": "src/GeneralPurposeIO/" },
    "files": ["src/GeneralPurposeIO/Common/Helpers/bytes.php"]
  },
  "autoload-dev": {
    "psr-4": { "ScrapyardIO\\Tests\\": "tests/" }
  },
  "extra": {
    "branch-alias": { "dev-master": "0.8.x-dev", "dev-main": "0.8.x-dev", "dev-0.8.x": "0.8.x-dev" },
    "venusian": {
      "providers": ["GeneralPurposeIO\\Core\\Providers\\ScrapyardIOServiceProvider"],
      "aliases": {
        "Circuit": "GeneralPurposeIO\\Core\\MagicAliases\\Circuit",
        "GPIO": "GeneralPurposeIO\\Core\\MagicAliases\\GPIO"
      }
    }
  },
  "config": { "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/venusian/framework", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/posix", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/gpio", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/i2c", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/spi", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/uart", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/ftdi", "options": { "symlink": true } },
    { "type": "path", "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/microscrap/mpsse", "options": { "symlink": true } }
  ]
}
